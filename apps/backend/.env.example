# Backend environment sample.
# Copy to apps/backend/.env for `make backend` or local Spring Boot runs.

# === Required for local backend runtime ===
POSTGRES_URL=jdbc:postgresql://localhost:5432/log_monitoring
POSTGRES_USER=log_user
POSTGRES_PASSWORD=change-me
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/log_monitoring
CLICKHOUSE_USER=log_user
CLICKHOUSE_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. Leave empty when Redis has no password.
REDIS_PASSWORD=
PROMETHEUS_API_URL=http://localhost:9090

# === Optional: server and CORS ===
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:3000

# === Required in production: security secrets ===
JWT_SECRET=change-me-to-a-long-random-hmac-secret
JWT_EXPIRATION_MS=86400000
JWT_ACCESS_TOKEN_BLACKLIST_PREFIX=identity:access_token:blacklist:
JWT_REFRESH_TOKEN_PREFIX=identity:refresh_token:
JWT_USER_REFRESH_TOKEN_PREFIX=identity:user_refresh_token:
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
BCRYPT_STRENGTH=10

# === Optional: application API key generation/cache ===
API_KEY_PREFIX=lms_live_
API_KEY_PREFIX_CHARACTERS=abcdefghijklmnopqrstuvwxyz0123456789
API_KEY_RANDOM_PREFIX_LENGTH=10
API_KEY_SECRET_LENGTH_BYTES=32
API_KEY_CACHE_PREFIX=identity:api_key:verification:
API_KEY_CACHE_INDEX_PREFIX=identity:api_key:verification_index:
API_KEY_CACHE_TTL_SECONDS=300

# === Optional: Kafka consumer groups, retries, and topics ===
KAFKA_CONSUMER_GROUP_LOG_PROCESSING=log-processing-group
KAFKA_CONSUMER_GROUP_REALTIME=realtime-live-log-group
KAFKA_CONSUMER_GROUP_ALERTS_CRITICAL=alerts-critical-group
KAFKA_CONSUMER_GROUP_ANOMALY_SIGNALS=anomaly-signals-group
KAFKA_CONSUMER_GROUP_ANOMALY_DETECTED_ALERTING=alerting-anomaly-detected-group
KAFKA_PUBLISH_TIMEOUT=5s
KAFKA_RETRY_AUTO_CREATE_TOPICS=false
KAFKA_RETRY_DLT_TOPIC_SUFFIX=.DLT
KAFKA_RAW_PROCESSING_RETRY_ATTEMPTS=3
KAFKA_RAW_PROCESSING_RETRY_BACKOFF_MS=1000
KAFKA_REALTIME_DELIVERY_RETRY_ATTEMPTS=3
KAFKA_REALTIME_DELIVERY_RETRY_BACKOFF_MS=1000
KAFKA_ALERTS_CRITICAL_DELIVERY_RETRY_ATTEMPTS=3
KAFKA_ALERTS_CRITICAL_DELIVERY_RETRY_BACKOFF_MS=1000
KAFKA_TOPIC_LOGS_RAW=logs.raw
KAFKA_TOPIC_LOGS_RAW_DLT=logs.raw.DLT
KAFKA_TOPIC_LOGS_LIVE=logs.live
KAFKA_TOPIC_LOGS_LIVE_DLT=logs.live.DLT
KAFKA_TOPIC_ALERTS_CRITICAL=alerts.critical
KAFKA_TOPIC_ALERTS_CRITICAL_DLT=alerts.critical.DLT
KAFKA_TOPIC_PROCESSING_ERRORS=processing.errors
KAFKA_TOPIC_ANOMALY_SIGNALS=logs.anomaly.signals
KAFKA_TOPIC_ANOMALY_SIGNALS_DLT=logs.anomaly.signals.DLT
KAFKA_TOPIC_ANOMALY_DETECTED=anomaly.detected
KAFKA_TOPIC_ANOMALY_DETECTED_DLT=anomaly.detected.DLT

# === Optional: ingestion, alerting, anomaly, and retention tuning ===
LOG_INGESTION_IDEMPOTENCY_KEY_PREFIX=logs:ingestion:idempotency
LOG_INGESTION_IDEMPOTENCY_TTL=24h
ALERT_RULE_CACHE_KEY_PREFIX=alerting:rules:active:
ALERT_RULE_CACHE_TTL=5m
ALERT_THRESHOLD_CACHE_KEY_PREFIX=alerting:evaluation:
ALERT_IDEMPOTENCY_TTL_SECONDS=86400
ANOMALY_INDEX_TTL=15m
ANOMALY_METRIC_SCRAPE_INTERVAL=10s
ANOMALY_METRIC_FRESHNESS_TTL=60s
RETENTION_INTERVAL_MS=3600000

# === Optional: Telegram alert delivery ===
# Required only when Telegram notification delivery is enabled.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=

# === Optional: incident AI assistant ===
# API key is required only when AI analysis is enabled/used.
INCIDENT_AI_PROVIDER=gemini
INCIDENT_AI_API_BASE_URL=https://generativelanguage.googleapis.com
INCIDENT_AI_API_KEY=
INCIDENT_AI_MODEL=gemini-3.1-flash-lite
INCIDENT_AI_TIMEOUT=30s
