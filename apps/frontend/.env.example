# Frontend environment sample.
# Copy to apps/frontend/.env.local for Vite dev, or pass as Docker build args.

# Required. REST API base URL used by axios.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Required. WebSocket/STOMP endpoint. http(s) values are normalized to ws(s) by the client.
VITE_WS_URL=http://localhost:8080/ws
